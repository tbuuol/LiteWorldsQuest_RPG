  "quests": [
   {
    "id": "wood",
    "npc": "tobin",
    "title": "Wood for the Hearth",
    "offer": "Winter comes early up here. Bring me three oak logs from the old oaks around the village, and I will lend you my second axe.",
    "done": "Good, solid oak. Here, take the axe -- and mind your fingers.",
    "need": {
     "bring": {
      "oak_log": 3
     }
    },
    "reward": {
     "items": [
      "copper_axe"
     ],
     "sk": {
      "woodcutting": 15
     }
    },
    "giver": "Tobin the Woodcutter"
   },
   {
    "id": "boars",
    "npc": "mara",
    "title": "A Boar for the Pot",
    "offer": "The stew wants meat. Four boars roam the Greenwood west of the fence. Bring them down, and I will stitch you a jerkin from the hides.",
    "done": "That will feed the whole village! Here is your jerkin, still warm.",
    "need": {
     "kill": {
      "boar": 4
     }
    },
    "reward": {
     "items": [
      "hide_jerkin"
     ],
     "sk": {
      "anatomy": 15
     }
    },
    "giver": "Mara the Cook"
   },
   {
    "id": "forge",
    "npc": "bram",
    "title": "Steel for the Gate",
    "after": "wood",
    "offer": "Raiders test our gate every night. Go to the forge east of the square and make a weapon with your own hands.",
    "done": "A fine first piece. The village is stronger for it. Take this shield; you will need it.",
    "need": {
     "make": "weapon"
    },
    "reward": {
     "items": [
      "oak_shield"
     ],
     "sk": {
      "smithing": 20
     }
    },
    "giver": "Elder Bram"
   },
   {
    "id": "wolves",
    "npc": "pip",
    "title": "Wolves at Night",
    "after": "boars",
    "offer": "I heard wolves howling east of the village! Three of them! Can you make them stop? Please?",
    "done": "It is quiet now! You can have my lucky coin. It is very lucky. Mostly.",
    "need": {
     "kill": {
      "wolf": 3
     }
    },
    "reward": {
     "items": [
      "lucky_coin"
     ],
     "sk": {
      "evade": 20
     }
    },
    "giver": "Pip"
   },
   {
    "id": "spiders",
    "npc": "bram",
    "title": "The Spider Nest",
    "after": "wolves",
    "offer": "North of the village the forest grows dark. Spiders nest there and take our herb gatherers. Kill three and bring peace back.",
    "done": "You have done Blockshire a great service. These gloves were woven from their own silk -- wear them with pride.",
    "need": {
     "kill": {
      "spider": 3
     }
    },
    "reward": {
     "items": [
      "silk_gloves"
     ],
     "mats": {
      "wild_herb": 3
     },
     "sk": {
      "toughness": 30
     }
    },
    "giver": "Elder Bram"
   },
   {
    "id": "crabs",
    "npc": "marisol",
    "giver": "Marisol",
    "title": "Crab Stew",
    "offer": "Six shore crabs, that's all I need. West along the sand, where the cove starts. They pinch, so mind your fingers.",
    "done": "Look at these! Stew for the whole harbour. Here, take some sea salt for your trouble -- and a pearl I found in one.",
    "need": {
     "kill": {
      "crab": 6
     }
    },
    "reward": {
     "mats": {
      "pearl": 1,
      "sea_salt": 2
     },
     "sk": {
      "evade": 20
     }
    }
   },
   {
    "id": "sirens",
    "npc": "ysolde",
    "giver": "Harbourmaster Ysolde",
    "title": "Songs in the Shallows",
    "after": "crabs",
    "offer": "Sirens sing in the cove and our fishermen walk into the sea. Silence four of them before we lose another boat.",
    "done": "Quiet at last. Their charms are said to sharpen the mind. Wear this one.",
    "need": {
     "kill": {
      "siren": 4
     }
    },
    "reward": {
     "items": [
      "siren_charm"
     ],
     "sk": {
      "evade": 25
     }
    }
   },
   {
    "id": "drowned",
    "npc": "finn",
    "giver": "Old Finn",
    "title": "Rest for the Drowned",
    "offer": "My old crew lies out by the wreck. Something won't let them rest. Put four of them back in the sand, will you?",
    "done": "Thank you. Here, my old sea boots. They've seen more storms than you have.",
    "need": {
     "kill": {
      "drowned": 4
     }
    },
    "reward": {
     "items": [
      "sea_boots"
     ],
     "sk": {
      "anatomy": 25
     }
    }
   },
   {
    "id": "captain",
    "npc": "ysolde",
    "giver": "Harbourmaster Ysolde",
    "title": "The Black Sails",
    "after": "sirens",
    "offer": "That ship out past the dock flies black sails. Captain Blackgill raids our boats every week. Row out with friends, board her and end him.",
    "done": "Blackgill is gone? Then Saltwind can fish in peace. Take his coat -- it suits a hero better than a thief.",
    "need": {
     "kill": {
      "captain": 1
     }
    },
    "reward": {
     "items": [
      "captains_coat"
     ],
     "sk": {
      "sword": 40,
      "toughness": 30
     }
    }
   }
